{
  "name": "rootscan-io",
  "version": "0.1.0",
  "license": "MIT",
  "scripts": {
    "setup": "pnpm i && docker compose up -d",
    "api": "nx run block-explorer-indexer:api",
    "api-dev": "nx run block-explorer-indexer:api-dev",
    "dev": "nx run block-explorer-indexer:dev",
    "scheduler": "nx run block-explorer-indexer:scheduler",
    "worker": "nx run block-explorer-indexer:worker",
    "bull-board": "nx run bull-board:start",
    "block-explorer": "nx run block-explorer:dev",
    "lint": "nx run-many --target=lint --exclude=portal --all --parallel --max-warnings=0 && pre-commit run --all-files",
    "precommit": "pre-commit run --all-files",
    "docker-down": "docker compose down",
    "prepare": "husky",
    "test": "nx run-many --target=test"
  },
  "private": true,
  "devDependencies": {
    "@nestjs/schematics": "^10.0.1",
    "@nestjs/testing": "^10.0.2",
    "@nx/eslint": "19.2.0",
    "@nx/eslint-plugin": "19.2.0",
    "@nx/jest": "19.2.0",
    "@nx/js": "19.2.0",
    "@nx/nest": "19.2.0",
    "@nx/node": "19.2.0",
    "@nx/web": "19.2.0",
    "@nx/webpack": "19.2.0",
    "@polkadot/types": "11.3.1",
    "@swc-node/register": "~1.9.1",
    "@swc/core": "~1.5.7",
    "@swc/helpers": "~0.5.11",
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "@types/jest": "^29.4.0",
    "@types/node": "~18.16.9",
    "@typescript-eslint/eslint-plugin": "^7.8.0",
    "eslint": "~8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.4.1",
    "jest-environment-node": "^29.4.1",
    "nx": "19.2.0",
    "prettier": "^2.6.2",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "ts-jest": "^29.1.0",
    "ts-node": "10.9.1",
    "typescript": "~5.4.2"
  },
  "engines": {
    "node": ">=18",
    "npm": "please-use-pnpm",
    "yarn": "please-use-pnpm",
    "pnpm": ">=9.1.0"
  },
  "optionalDependencies": {
    "husky": "^9.0.11"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.2",
    "@nestjs/config": "^3.2.2",
    "@nestjs/core": "^10.0.2",
    "@nestjs/platform-express": "^10.0.2",
    "@polkadot/api": "11.3.1",
    "@polkadot/util": "^13.0.2",
    "@therootnetwork/api": "^1.0.9",
    "@therootnetwork/api-types": "^1.0.3",
    "@therootnetwork/evm": "^1.0.5",
    "axios": "^1.6.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0",
    "tslib": "^2.3.0"
  }
}
